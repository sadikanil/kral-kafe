# Supabase baglanti sablonu.
#
#   cp .env.supabase.example .env.supabase
#
# Doldurduktan sonra bu dosya .gitignore'da oldugu icin depoya GIRMEZ.
# Yerel gelistirme .env icinde SQLite ile devam eder; bu dosya sadece
# Supabase'e karsi migration calistirmak ve baglantiyi dogrulamak icin.

APP_ENV=supabase
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Veritabani -------------------------------------------------------------
# Supabase paneli: Project Settings > Database > Connection string > Session pooler
#
# PORT 5432 (session pooler). 6543 (transaction pooler) KULLANMA:
# o mod PDO::ATTR_EMULATE_PREPARES gerektiriyor, bu da boolean yazmalarini
# SQLSTATE[42804] ile kiriyor - gercek Supabase uzerinde goruldu. Ayrica DDL ve
# uzun migration transaction lari transaction pooler da guvenilir calismaz.
#
# DB_HOST pooler adresidir: aws-0-<bolge>.pooler.supabase.com
# (db.<proje-ref>.supabase.co dogrudan baglantidir ve yalnizca IPv6 uzerinden gelir.)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

# --- Depolama ---------------------------------------------------------------
# Supabase paneli: Storage > bucket olustur, sonra
# Project Settings > Storage > S3 access keys
UPLOAD_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
# Herkese acik nesne adresi (bucket "Public" olmali):
# https://<proje-ref>.supabase.co/storage/v1/object/public/<bucket>
AWS_URL=

MAIL_MAILER=log

# Yalnizca Supabase TRANSACTION pooler'i (port 6543) kullanilacaksa true yapin.
# Uyari: emulasyon acikken Postgres'te boolean yazmalari kirilir (42804).
# Onerilen yol session pooler (port 5432); o zaman bu ayar kapali kalmali.
DB_EMULATE_PREPARES=false

# Kafe gunu boyunca giris dusmesin (bkz. CafeConfigTest)
SESSION_LIFETIME=900
