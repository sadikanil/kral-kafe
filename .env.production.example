# Uretim sablonu (php2shell sertlestirmesi, 7 Kasim 2026).
#
# Bu dosya SIR ICERMEZ ve icermemeli. Vercel'de degerler panelden girilir
# (Settings -> Environment Variables -> Production); burasi hangi anahtarin
# uretimde ne olmasi gerektiginin listesi. Tam liste ve aciklamalar:
# README §12.2. Sirlar (APP_KEY, DB_PASSWORD, AWS_*, *_API_KEY, CRON_SECRET)
# yalnizca panelde durur.
#
# Baska bir sunucuda: cp .env.production.example .env  (sonra sirlari doldur)

APP_NAME="Kral Kafe"
APP_ENV=production
APP_KEY=
# Asla true olmasin: hata sayfasi istek basliklarini (Vercel jetonlari dahil)
# ve ortam degiskenlerini siteye giren herkese gosterir.
APP_DEBUG=false
APP_URL=https://kral-kafe-ten.vercel.app

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=900
# Cerez yalnizca HTTPS'te gider. Tanimsizken Laravel istegin HTTPS olup
# olmadigina bakar (proxy arkasinda TrustProxies sayesinde dogru); acik yazmak
# yanlis bir proxy ayarinda bile cerezi duz HTTP'ye sizdirmaz. Bos deger
# yazilmaz: "SESSION_SECURE_COOKIE=" false sayilir.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Oturum verisi veritabaninda (Supabase) sifreli durur. true'ya gecildigi an
# acik oturumlar bir kez duser (herkes bir kez yeniden giris yapar).
SESSION_ENCRYPT=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
UPLOAD_DISK=s3
