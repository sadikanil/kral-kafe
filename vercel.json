{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "regions": [
        "sin1"
    ],
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "maxDuration": 60
        }
    },
    "crons": [
        {
            "path": "/zamanlanmis/gunluk",
            "schedule": "0 20 * * *"
        }
    ],
    "routes": [
        {
            "src": "^/(css|js|img)/(.+)$",
            "has": [
                {
                    "type": "query",
                    "key": "v"
                }
            ],
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            },
            "continue": true
        },
        {
            "src": "^/$",
            "dest": "/api/index.php"
        },
        {
            "src": "^/(.+\\.php)$",
            "dest": "/api/index.php"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
